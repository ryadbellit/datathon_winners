# Copier vers .env (ignoré par git). AUCUN secret dans ce fichier.
# Identifiants AWS : profil (AWS_PROFILE), rôle IAM (ECS) ou, pour un atelier, AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN dans votre .env local.

# Routage {"tâche": ["fournisseur:model_id", ...]} : premier = préféré, suivants = fallback.
# Tâches : orchestration (synthèse), agent (agents), arbitration (avocat du diable + gouvernance ; optionnelle, sinon = orchestration), evaluation (juge), default.
LLM_ROUTES='{"default": ["mock:mock-model"]}'
# AWS Bedrock (IDs à vérifier avec `python -m alphaforge check-routes`) :
# LLM_ROUTES='{"orchestration": ["bedrock:global.anthropic.claude-sonnet-5-5", "mock:mock-model"], "agent": ["bedrock:global.anthropic.claude-haiku-5-5", "mock:mock-model"], "evaluation": ["bedrock:global.anthropic.claude-sonnet-5-5"]}'
LLM_MAX_TOKENS='{"default": 2048, "orchestration": 4096, "agent": 2048, "evaluation": 600}'
# Prix USD par million de tokens (page de tarification Bedrock). Vide = coût inconnu.
LLM_PRICING='{}'
# LLM_PRICING='{"anthropic.claude-sonnet-5-5": {"input_per_1m": 0.0, "output_per_1m": 0.0}}'

AWS_REGION=us-east-1
# AWS_PROFILE=mon-profil
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MAX_RETRIES=3

# Guardrail et Knowledge Base Bedrock (vide = désactivé)
# GUARDRAIL_ID=xxxxxxxxxxxx
# GUARDRAIL_VERSION=1
# KNOWLEDGE_BASE_ID=XXXXXXXXXX

# Stockage : local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data
# S3_BUCKET=mon-bucket
S3_PREFIX=alphaforge

# CloudWatch (vide = désactivé ; sur ECS laisser vide et utiliser le pilote awslogs)
# CLOUDWATCH_LOG_GROUP=/alphaforge/app
CLOUDWATCH_RETENTION_DAYS=14
CLOUDWATCH_METRICS=false

LOG_LEVEL=INFO
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=alphaforge
